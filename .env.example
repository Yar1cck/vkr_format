# Common
ENV=dev
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database
POSTGRES_DB=vkr
POSTGRES_USER=vkr
POSTGRES_PASSWORD=vkr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vkr:vkr@postgres:5432/vkr

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SYNC_PROCESSING=false

# Storage (S3/MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vkr-documents
S3_REGION=us-east-1
USE_S3=true
LOCAL_STORAGE_PATH=./storage

# CORS
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost

# Antivirus: в prod ставить true (clamscan должен быть в PATH).
# В dev можно false — uploads тогда не сканируются, в логах будет предупреждение.
ANTIVIRUS_REQUIRED=false

# Frontend
VITE_API_BASE_URL=http://localhost/api/v1
